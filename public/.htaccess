# La Toma Multiespacio — Apache (DonWeb) config
# Sirve la SPA + el HTML estático por ruta (SEO) con fallback a index.html.

Options -MultiViews
RewriteEngine On
RewriteBase /

# --- Forzar HTTPS ---
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Archivos y carpetas existentes: servir tal cual ---
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- HTML estático por ruta (ej. /reservas -> /reservas/index.html) para crawlers ---
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# --- Fallback SPA: cualquier otra ruta la maneja React Router ---
RewriteRule ^ /index.html [L]

# --- Cache de assets con hash ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# index.html y HTML por ruta: sin cache agresivo (para reflejar deploys)
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# --- Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
